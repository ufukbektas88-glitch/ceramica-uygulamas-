generator client {
 provider = "prisma-client-js"
 engineType = "client"
 output = "../node_modules/.prisma/client"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}
enum Role {
 ADMIN
 SALES
 WAREHOUSE
 FINANCE
 CUSTOMER
}
enum OrderStatus {
 RECEIVED
 CONFIRMED
 PREPARING
 SHIPPED
 DELIVERED
 CANCELLED
}
model User {
 id String @id @default(uuid())
 email String @unique
 name String
 passwordHash String
 role Role @default(CUSTOMER)
 sessions Session[]
 orders Order[]
 createdAt DateTime @default(now())
}
model Session {
 id String @id @default(uuid())
 tokenHash String @unique
 userId String
 user User @relation(fields:[userId], references:[id])
 expiresAt DateTime
 @@index([expiresAt])
}
model Brand {
 id String @id @default(uuid())
 name String @unique
 products Product[]
}
model Product {
 id String @id @default(uuid())
 sku String @unique
 name String
 brandId String
 brand Brand @relation(fields:[brandId], references:[id])
 collection String?
 size String?
 color String?
 surface String?
 boxArea Decimal @db.Decimal(12,4)
 price Decimal @db.Decimal(14,2)
 vatRate Decimal @db.Decimal(5,2)
 active Boolean @default(true)
 demo Boolean @default(false)
 lots InventoryLot[]
 orderItems OrderItem[]
 createdAt DateTime @default(now())
}
model Warehouse {
 id String @id @default(uuid())
 name String @unique
 lots InventoryLot[]
}
model InventoryLot {
 id String @id @default(uuid())
 productId String
 product Product @relation(fields:[productId],references:[id])
 warehouseId String
 warehouse Warehouse @relation(fields:[warehouseId],references:[id])
 batch String
 tone String?
 caliber String?
 physical Int
 reserved Int @default(0)
 @@unique([productId,warehouseId,batch])
 @@index([productId])
}
model Order {
 id String @id @default(uuid())
 number String @unique
 userId String
 user User @relation(fields:[userId],references:[id])
 idempotencyKey String
 status OrderStatus @default(RECEIVED)
 subtotal Decimal @db.Decimal(14,2)
 tax Decimal @db.Decimal(14,2)
 total Decimal @db.Decimal(14,2)
 deliveryAddress String
 items OrderItem[]
 history OrderStatusHistory[]
 createdAt DateTime @default(now())
 @@unique([userId,idempotencyKey])
 @@index([createdAt])
}
model OrderItem {
 id String @id @default(uuid())
 orderId String
 order Order @relation(fields:[orderId], references:[id])
 productId String
 product Product @relation(fields:[productId],references:[id])
 sku String
 name String
 boxes Int
 area Decimal @db.Decimal(12,4)
 unitPrice Decimal @db.Decimal(14,2)
 vatRate Decimal @db.Decimal(5,2)
 subtotal Decimal @db.Decimal(14,2)
 tax Decimal @db.Decimal(14,2)
 total Decimal @db.Decimal(14,2)
 lotId String
}
model OrderStatusHistory {
 id String @id @default(uuid())
 orderId String
 order Order @relation(fields:[orderId],references:[id])
 status OrderStatus
 actorId String
 createdAt DateTime @default(now())
}
model AuditLog {
 id String @id @default(uuid())
 actorId String
 action String
 entityId String
 data Json
 createdAt DateTime @default(now())
 @@index([entityId,createdAt])
}
model ImportJob {
 id String @id @default(uuid())
 brand String
 source String
 data Json
 status String @default("PENDING")
 actorId String
 createdAt DateTime @default(now())
 approvedAt DateTime?
}
