# Bu dosyayı .env olarak kopyalayın. .env dosyası depoya girmez.

# --- Zorunlu ---
ANTHROPIC_API_KEY=            # console.anthropic.com üzerinden alınır
PANEL_TOKEN=                  # panel girişi için uzun rastgele bir değer: openssl rand -hex 32
POSTGRES_PASSWORD=            # veritabanı parolası: openssl rand -hex 16

# --- İsteğe bağlı ---
VOYAGE_API_KEY=               # varsa anlamsal embedding kullanılır; yoksa yerel n-gram benzerliği
DAILY_TARGET=50
DAILY_RUN_HOUR=6              # Europe/Istanbul
DAILY_RUN_MINUTE=30
PIPELINE_CONCURRENCY=3
QUALITY_THRESHOLD=80
MAX_REWRITES=2
TOPIC_COOLDOWN_DAYS=30
# Maliyeti düşürmek için aşamalara ayrı model atanabilir (ör. claude-sonnet-5-5, claude-haiku-5-5)
MODEL_RESEARCH=claude-opus-5-5
MODEL_WRITER=claude-opus-5-5
MODEL_JUDGE=claude-opus-5-5
MODEL_SCORING=claude-opus-5-5
# Virgülle ayrılmış RSS adresleri; boş bırakılırsa varsayılan liste kullanılır
# RSS_FEEDS=
