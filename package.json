{
  "name": "ceramica",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces",
    "typecheck": "tsc --noEmit -p apps/api && npm run typecheck -w apps/web",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "node scripts/generate-client.cjs",
    "db:migrate": "node --env-file=.env scripts/migrate.cjs",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "admin:password": "node --env-file=.env scripts/admin-password.cjs",
    "test:integration": "node --env-file=.env --import tsx --test tests/api.integration.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.19.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "3.0.2",
    "decimal.js": "10.6.0",
    "pg": "^8.16.3",
    "exceljs": "4.4.0",
    "csv-parse": "7.0.3"
  },
  "devDependencies": {
    "@prisma/internals": "^6.19.0",
    "@types/node": "22.18.0",
    "@types/pg": "^8.15.5",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.31",
    "js-yaml": "5.5.0",
    "deepmerge-ts": "8.0.2",
    "effect": "3.20.0",
    "uuid": "11.1.1"
  }
}
